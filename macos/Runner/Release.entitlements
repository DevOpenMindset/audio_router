<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sandbox DISABLED: required for cross-process audio routing via Core Audio.
	     Distribuer hors App Store uniquement (Developer ID ou direct download). -->
	<key>com.apple.security.app-sandbox</key>
	<false/>

	<key>com.apple.security.network.client</key>
	<true/>

	<!-- Required for CATapDescription / AudioHardwareCreateProcessTap (macOS 14.2+).
	     Needs a provisioned Developer ID — request via Apple Developer portal. -->
	<key>com.apple.developer.avfoundation.allow-audio-system-tap</key>
	<true/>
</dict>
</plist>
