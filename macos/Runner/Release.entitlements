<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sandbox DISABLED: required for cross-process audio routing via Core Audio.
	     Distribuer hors App Store uniquement (Developer ID ou direct download). -->
	<key>com.apple.security.app-sandbox</key>
	<false/>

	<key>com.apple.security.network.client</key>
	<true/>

	<!-- CATapDescription / AudioHardwareCreateProcessTap needs no special
	     entitlement — it is gated by the audio-capture TCC prompt driven by
	     NSAudioCaptureUsageDescription in Info.plist. The restricted
	     com.apple.developer.avfoundation.allow-audio-system-tap entitlement
	     that used to be here cannot be ad-hoc signed and broke the build. -->
</dict>
</plist>
