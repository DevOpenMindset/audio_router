<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sandbox DISABLED: AudioRouter needs to control other apps' audio routing.
	     A sandboxed app cannot set kAudioProcessPropertyDevice on other processes
	     or write LaunchAgent plists. Distribute outside the App Store. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>

	<!-- Network access (needed by window_manager / system_tray plugins) -->
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
